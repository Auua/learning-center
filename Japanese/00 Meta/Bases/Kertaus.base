properties:
  jlpt:
    displayName: JLPT
  type:
    displayName: Tyyppi
  status:
    displayName: Status
  confidence:
    displayName: Varmuus
  reviewed:
    displayName: Kerrattu
  topic:
    displayName: Aihe
  cause:
    displayName: Syy
  recurring:
    displayName: Toistuva
  fixed:
    displayName: Korjattu
views:
  - type: table
    name: Heikoimmat ensin
    filters:
      and:
        - confidence <= 2
        - or:
            - type == "grammar"
            - type == "compare"
            - type == "form"
            - type == "sentences"
    order:
      - file.name
      - type
      - jlpt
      - confidence
      - status
      - reviewed
    sort:
      - property: reviewed
        direction: DESC
      - property: confidence
        direction: ASC
    limit: 15
  - type: table
    name: Heikoimmat ensin — N4
    filters:
      and:
        - confidence <= 2
        - jlpt == "N4"
        - or:
            - type == "grammar"
            - type == "compare"
            - type == "form"
            - type == "sentences"
    order:
      - file.name
      - type
      - confidence
      - status
      - reviewed
    sort:
      - property: confidence
        direction: ASC
    limit: 15
  - type: table
    name: Heikoimmat ensin — N3
    filters:
      and:
        - confidence <= 2
        - jlpt == "N3"
        - or:
            - type == "grammar"
            - type == "compare"
            - type == "form"
            - type == "sentences"
    order:
      - file.name
      - type
      - confidence
      - status
      - reviewed
    sort:
      - property: confidence
        direction: ASC
    limit: 15
  - type: table
    name: Uudet
    filters:
      and:
        - status == "new"
        - or:
            - type == "grammar"
            - type == "compare"
            - type == "form"
            - type == "sentences"
    order:
      - file.name
      - type
      - jlpt
    limit: 15
  - type: table
    name: Uudet — N4
    filters:
      and:
        - status == "new"
        - jlpt == "N4"
        - or:
            - type == "grammar"
            - type == "compare"
            - type == "form"
            - type == "sentences"
    order:
      - file.name
      - type
    limit: 15
  - type: table
    name: Uudet — N3
    filters:
      and:
        - status == "new"
        - jlpt == "N3"
        - or:
            - type == "grammar"
            - type == "compare"
            - type == "form"
            - type == "sentences"
    order:
      - file.name
      - type
    limit: 15
  - type: table
    name: Työn alla
    filters:
      and:
        - status == "learning"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - jlpt
      - confidence
  - type: table
    name: Epävarmat
    filters:
      and:
        - status == "shaky"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - jlpt
      - confidence
  - type: table
    name: Epävarmat — N4
    filters:
      and:
        - status == "shaky"
        - jlpt == "N4"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - confidence
  - type: table
    name: Epävarmat — N3
    filters:
      and:
        - status == "shaky"
        - jlpt == "N3"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - confidence
  - type: table
    name: Osatut
    filters:
      and:
        - status == "known"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - jlpt
      - confidence
  - type: table
    name: Osatut — N4
    filters:
      and:
        - status == "known"
        - jlpt == "N4"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - confidence
  - type: table
    name: Osatut — N3
    filters:
      and:
        - status == "known"
        - jlpt == "N3"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - confidence
  - type: table
    name: Toistuvat virheet
    filters:
      and:
        - type == "mistake"
        - recurring == true
        - fixed == false
    order:
      - file.name
      - topic
      - cause
      - date
    sort:
      - property: date
        direction: DESC
