properties:
  kind:
    displayName: Tyyppi
  level:
    displayName: Taso
  status:
    displayName: Tila
  url:
    displayName: URL
  author:
    displayName: Tekijä
views:
  - type: table
    name: Kaikki lähteet
    filters:
      and:
        - type == "source"
    order:
      - file.name
      - kind
      - level
      - status
      - url
    sort:
      - property: kind
        direction: ASC
  - type: table
    name: Tyypeittäin
    filters:
      and:
        - type == "source"
    groupBy:
      property: kind
      direction: ASC
    order:
      - file.name
      - level
      - status
      - url
