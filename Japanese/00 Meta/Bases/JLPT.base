        direction: ASC
  - type: table
    name: N2
    filters:
      and:
        - 'jlpt == "N2"'
    groupBy:
      property: note.type
      direction: ASC
    order:
      - file.name
      - note.reading
      - note.meaning
      - note.func
      - note.status
      - note.confidence
    sort:
      - property: note.confidence
        direction: ASC
  - type: table
    name: N1
    filters:
      and:
        - 'jlpt == "N1"'
    groupBy:
      property: note.type
      direction: ASC
    order:
      - file.name
      - note.reading
      - note.meaning
      - note.func
      - note.status
      - note.confidence
    sort:
      - property: note.confidence
        direction: ASC
