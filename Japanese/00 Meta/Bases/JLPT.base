properties:
  jlpt:
    displayName: JLPT
  type:
    displayName: Tyyppi
  status:
    displayName: Status
  confidence:
    displayName: Varmuus
  reading:
    displayName: Lukutapa
  meaning:
    displayName: Merkitys
  func:
    displayName: Funktio
views:
  - type: table
    name: Kaikki tasot
    filters:
      and:
        - jlpt
    groupBy:
      property: jlpt
      direction: ASC
    order:
      - file.name
      - type
      - status
      - confidence
  - type: table
    name: N5
    filters:
      and:
        - jlpt == "N5"
        - '!status.containsAny("known", "learning", "shaky")'
    groupBy:
      property: type
      direction: ASC
    order:
      - status
      - file.name
      - reading
      - onyomi
      - kunyomi
      - meaning
      - func
      - confidence
    sort: []
    columnSize:
      file.name: 254
      note.reading: 358
      note.status: 53
      note.confidence: 41
  - type: table
    name: N4
    filters:
      and:
        - jlpt == "N4"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - reading
      - meaning
      - func
      - status
      - confidence
    sort:
      - property: confidence
        direction: ASC
  - type: table
    name: N3
    filters:
      and:
        - jlpt == "N3"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - reading
      - meaning
      - func
      - status
      - confidence
    sort:
      - property: confidence
        direction: ASC
  - type: table
    name: N2
    filters:
      and:
        - jlpt == "N2"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - reading
      - meaning
      - func
      - status
      - confidence
    sort:
      - property: confidence
        direction: ASC
  - type: table
    name: N1
    filters:
      and:
        - jlpt == "N1"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - reading
      - meaning
      - func
      - status
      - confidence
    sort:
      - property: confidence
        direction: ASC
