properties:
  jlpt:
    displayName: JLPT
  func:
    displayName: Funktio
  attaches:
    displayName: Liittyy muotoon
  compare:
    displayName: Vertailu
  status:
    displayName: Status
  confidence:
    displayName: Varmuus
  members:
    displayName: Jäsenet
  formality:
    displayName: Tyyli
views:
  - type: table
    name: Kaikki kieliopit
    filters:
      and:
        - type == "grammar"
    order:
      - file.name
      - jlpt
      - func
      - attaches
      - status
      - confidence
    sort:
      - property: jlpt
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Heikoilla jäillä
    filters:
      and:
        - type == "grammar"
        - confidence <= 2
    order:
      - file.name
      - jlpt
      - confidence
      - status
      - compare
    sort:
      - property: confidence
        direction: ASC
  - type: table
    name: Tasoittain
    filters:
      and:
        - type == "grammar"
    groupBy:
      property: jlpt
      direction: ASC
    order:
      - file.name
      - func
      - status
      - confidence
  - type: table
    name: Vertailut
    filters:
      and:
        - type == "compare"
    order:
      - file.name
      - members
      - jlpt
      - status
    sort:
      - property: jlpt
        direction: ASC
